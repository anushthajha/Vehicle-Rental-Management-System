# ── MySQL (Aiven) ─────────────────────────────────────────────────────────────
# Copy the "Service URI" from Aiven console → your MySQL service → Overview
# It looks like: mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# The app will auto-convert it to mysql+aiomysql://... with ssl=true
MYSQL_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:PORT/defaultdb?ssl-mode=REQUIRED

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# From Atlas → Connect → Drivers → copy the SRV URI
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sigfleet_docs

# ── Redis (optional — leave blank to run without caching/rate-limiting) ───────
REDIS_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Cookies (cross-domain — Vercel frontend + Render backend) ─────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ── CORS / URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-render-app.onrender.com/api
# Extra origins (comma-separated), e.g. custom domain:
CORS_ORIGINS=

# ── Email (Gmail App Password recommended) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=SigFleet
SMTP_USE_TLS=true

# ── AI Keys ───────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
SKIP_DB_WAIT=true
RUN_SEED=false
