# Docker Deployment Environment Variables
# Copy this to .env before running docker-compose up

# MySQL (internal Docker network)
MYSQL_URL=mysql+aiomysql://zoomuser:zoompass@mysql:3306/zoomcar

# MongoDB (internal Docker network)
MONGODB_URL=mongodb://mongouser:mongopass@mongodb:27017/zoomcar_docs?authSource=admin
MONGODB_DB_NAME=zoomcar_docs

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=sigfleet-production-secret-key-change-this-to-random-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email (Gmail SMTP — use App Password, not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sigmoidanushtha@gmail.com
SMTP_PASSWORD=jxovvjfkbcrtvrrc
SMTP_FROM=sigmoidanushtha@gmail.com
SMTP_FROM_NAME=SigFleet
SMTP_USE_TLS=true

# App URLs (change to your server IP or domain)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001/api
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Payment (simulated)
PAYMENT_SIMULATE=true
